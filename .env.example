WEB_PORT=5173
API_PORT=5080

# Production HTTPS deployment. Set these before using docker-compose.production.yml.
DOMAIN=
ACME_EMAIL=

# Optional server-side campaign generation settings; keep the key out of Vite.
STORYKEEPER_AI_BASE_URL=
STORYKEEPER_AI_MODEL=
STORYKEEPER_AI_API_KEY=
STORYKEEPER_AI_TIMEOUT_SECONDS=60
STORYKEEPER_AI_RECENT_TURN_LIMIT=8
STORYKEEPER_AI_RECENT_TURN_CHARACTER_BUDGET=12000

# Optional server-side narrated playback. Select one provider explicitly.
TEXT_TO_SPEECH_ENABLED=false
TEXT_TO_SPEECH_PROVIDER=Disabled
TEXT_TO_SPEECH_BASE_URL=
TEXT_TO_SPEECH_API_KEY=
TEXT_TO_SPEECH_MODEL=
TEXT_TO_SPEECH_NARRATOR_VOICE=
TEXT_TO_SPEECH_OUTPUT_FORMAT=mp3_44100_128
TEXT_TO_SPEECH_TIMEOUT_SECONDS=30
TEXT_TO_SPEECH_CACHE_ENABLED=true
TEXT_TO_SPEECH_CACHE_DIRECTORY=

# Required to unlock parent controls. Set a private PIN; do not reuse an account password.
STORYKEEPER_PARENT_PIN=
