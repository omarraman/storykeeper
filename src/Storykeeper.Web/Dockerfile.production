FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY src/Storykeeper.Web/package.json src/Storykeeper.Web/package.json
RUN npm ci
COPY src/Storykeeper.Web/ src/Storykeeper.Web/
RUN npm run build --workspace @storykeeper/web

FROM nginx:1.27-alpine
COPY src/Storykeeper.Web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/src/Storykeeper.Web/dist/ /usr/share/nginx/html/

EXPOSE 80
